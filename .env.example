# Copiá a .env.local (gitignored). No commitees contraseñas.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/patitas
# AUTH_SECRET=generá-un-secreto-largo-en-producción
# APP_BASE_URL=http://localhost:3000
# EmailJS (activación portal — servidor, ADR-0007)
# En el template: To Email = {{email}} o {{to_email}}
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# Emails transaccionales de turno (un template por tipo o uno solo EMAILJS_TEMPLATE_TURNO_ID)
# EMAILJS_TEMPLATE_TURNO_ID=
# EMAILJS_TEMPLATE_TURNO_AGENDADO_ID=
# EMAILJS_TEMPLATE_TURNO_REPROGRAMADO_ID=
# EMAILJS_TEMPLATE_TURNO_CANCELADO_ID=
# EMAILJS_TEMPLATE_TURNO_RECORDATORIO_ID=
# Secreto para POST /api/cron/recordatorios-turnos (cron cada ~15 min)
# CRON_SECRET=
