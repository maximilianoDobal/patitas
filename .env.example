# Copiá a .env.local (gitignored). No commitees contraseñas.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/patitas
# AUTH_SECRET=generá-un-secreto-largo-en-producción
# APP_BASE_URL=http://localhost:3000
# EmailJS — plan free: máximo 2 templates (ver README)
# Servicio + keys compartidos por activación y turnos.
# EMAILJS_SERVICE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# Template 1: activación portal / elegir contraseña ({{link_activacion}}, {{nombre}}, {{sucursal}})
# EMAILJS_TEMPLATE_ID=
# Template 2: todos los mails de turno (agendado, reprogramado, cancelado, recordatorio 24h)
# To Email = {{to_email}} · Subject = {{subject}}
# EMAILJS_TEMPLATE_TURNO_ID=
# Secreto para POST /api/cron/recordatorios-turnos (cron cada ~15 min)
# CRON_SECRET=
